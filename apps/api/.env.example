# ---- Application ----
# LOCAL DEVELOPMENT template. The vendor name here is deliberate and should be LEFT ALONE: this
# file never reaches a customer instance (that is .env.production.example, which is neutral), and
# neutralising it only makes local runs harder to read. A customer academy's name is set by
# `php artisan install:academy`, which writes it to the database.
APP_NAME=HElbaron
APP_ENV=local
APP_KEY=
# Secure-by-default template (L1): a copied .env never ships with debug on. Set true locally if you
# want stack traces; production MUST keep this false (enforced by `php artisan env:validate`).
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
# Supported locales (bilingual AR/EN). RTL handled on the frontend.
APP_SUPPORTED_LOCALES=en,ar

# ---- Logging ----
LOG_CHANNEL=stack
LOG_LEVEL=debug

# ---- Database (PostgreSQL) ----
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=55432
DB_DATABASE=helbaron
DB_USERNAME=helbaron
DB_PASSWORD=secret

# ---- Cache / Queue / Session (Redis + Horizon) ----
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6380
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

# ---- Filesystem (S3 + CloudFront) ----
FILESYSTEM_DISK=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=me-south-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
CLOUDFRONT_URL=

# ---- Video (Mux) ----
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_SIGNING_KEY_ID=
MUX_SIGNING_KEY_PRIVATE=

# ---- Sanctum (SPA) ----
SANCTUM_STATEFUL_DOMAINS=localhost:3000
FRONTEND_URL=http://localhost:3000
# Personal-access-token lifetime in minutes (H7). Default 43200 = 30 days. Expired tokens are
# rejected at auth time and pruned daily by `sanctum:prune-expired`. Leave blank/non-numeric only
# if you explicitly want non-expiring tokens.
SANCTUM_TOKEN_EXPIRATION_MINUTES=43200

# ---- Horizon ----
HORIZON_PREFIX=helbaron_horizon

# ---- Mail (local: log only; never sends real email) ----
MAIL_MAILER=log
MAIL_FROM_ADDRESS=no-reply@helbaron.local
MAIL_FROM_NAME=HElbaron

# ---------------------------------------------------------------------------
# Step 14 — External Integrations (all optional; empty => fake providers)
# Local/test MUST stay on fake providers. Production sets these + the *_PROVIDER
# selectors below. Never commit real secrets.
# ---------------------------------------------------------------------------

# Payments — Stripe (COMMERCE_PAYMENT_PROVIDER=stripe to enable)
COMMERCE_PAYMENT_PROVIDER=fake
STRIPE_BASE_URL=https://api.stripe.com
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_WEBHOOK_TOLERANCE=300

# Video — Mux signed playback (LEARNING_PLAYBACK_PROVIDER=mux)
LEARNING_PLAYBACK_PROVIDER=fake
MUX_SIGNING_KEY_ID=
MUX_SIGNING_KEY=
MUX_STREAM_BASE_URL=https://stream.mux.com
MUX_TOKEN_AUDIENCE=v

# Private media via CloudFront (LEARNING_PLAYBACK_PROVIDER=cloudfront)
CLOUDFRONT_URL=
CLOUDFRONT_KEY_PAIR_ID=
CLOUDFRONT_PRIVATE_KEY=

# S3 (also used for certificate/export storage disks)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Storage disk selection for signed downloads (local | s3)
CERTIFICATION_PDF_DISK=local
ANALYTICS_EXPORT_DISK=local

# Email — Mailgun (NOTIFICATIONS_MAIL_PROVIDER=mailgun)
NOTIFICATIONS_MAIL_PROVIDER=fake
MAILGUN_BASE_URL=https://api.mailgun.net
MAILGUN_DOMAIN=
MAILGUN_SECRET=
MAILGUN_FROM=

# SMS — Twilio (NOTIFICATIONS_SMS_PROVIDER=twilio)
NOTIFICATIONS_SMS_PROVIDER=fake
TWILIO_BASE_URL=https://api.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Push — Firebase FCM (NOTIFICATIONS_PUSH_PROVIDER=firebase)
NOTIFICATIONS_PUSH_PROVIDER=fake
FIREBASE_BASE_URL=https://fcm.googleapis.com
FIREBASE_SERVER_KEY=

# ---------------------------------------------------------------------------
# Step 15 — Production hardening (safe local defaults; tighten in production)
# ---------------------------------------------------------------------------
APP_VERSION=1.0.0-rc.1

# Error tracking (Sentry) — leave DSN empty to disable entirely.
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# ---------------------------------------------------------------------------
# White-label — per-instance branding
# ---------------------------------------------------------------------------
# This product is deployed as a SEPARATE INSTANCE per customer academy. These keys are the built-in
# defaults BrandSetting falls back to before an admin saves anything in the branding screen, so a
# freshly provisioned instance is already branded for its own academy. Anything set through the
# admin panel overrides them.
#
# THE OPTIONAL KEYS BELOW ARE COMMENTED OUT ON PURPOSE — DO NOT "TIDY" THEM BACK IN AS `KEY=`.
# Laravel's env('KEY', $default) returns the default only when the key is ABSENT. A key written as
# `KEY=` is present with the value '', so the default never fires. Shipping them empty meant a fresh
# instance got a blank Arabic brand name, blank company name (which also feeds the certificate
# issuer) and blank email footers. Uncomment a key only when you are giving it a real value.
# `${APP_NAME}` interpolation is supported (phpdotenv 5.6) and verified by test.
BRAND_NAME_EN="${APP_NAME}"
#BRAND_NAME_AR=
#BRAND_COMPANY_NAME=
#BRAND_SUPPORT_EMAIL=
#BRAND_SUPPORT_PHONE=
#BRAND_ADDRESS_EN=
#BRAND_ADDRESS_AR=
BRAND_TIMEZONE=UTC
BRAND_CURRENCY=SAR
BRAND_THEME_PRESET=default
#BRAND_EMAIL_FOOTER_EN=
#BRAND_EMAIL_FOOTER_AR=
#BRAND_EMAIL_SIGNATURE_EN=
#BRAND_EMAIL_SIGNATURE_AR=
# Printed on certificates. Falls back to the branding company name, then APP_NAME.
#CERTIFICATION_ISSUER=

# Development super admin created by IdentitySeeder. The seeder REFUSES to create this account in
# production, and outside local/testing it refuses unless SEED_ADMIN_PASSWORD is set explicitly.
# On a real customer instance do not seed an admin at all — run `php artisan identity:create-admin`.
SEED_ADMIN_EMAIL=admin@helbaron.local
SEED_ADMIN_NAME="Local Admin"
# Commented out, not blank: `SEED_ADMIN_PASSWORD=` is present-but-empty, so the seeder's default
# never fired and the local admin was created with an empty password that cannot be used to log in.
# Left absent, the seeder uses its documented development default. Set it to a real value to
# override, which is also what the seeder requires outside local/testing.
#SEED_ADMIN_PASSWORD=

# Demo environment (never runs in production; `demo:seed` refuses unless DEMO_MODE=true).
DEMO_MODE=false
DEMO_SEED=20260711
DEMO_RESET_ALLOWED=false
DEMO_EXTERNAL_MEDIA=true
# Scale profile: showcase (fast, CI-safe default) or enterprise (large, provisioning host).
DEMO_SCALE=showcase

# Security headers / CSP / HSTS
SECURITY_FRAME_OPTIONS=DENY
SECURITY_REFERRER_POLICY=strict-origin-when-cross-origin
SECURITY_PERMISSIONS_POLICY="geolocation=(), microphone=(), camera=(), payment=()"
SECURITY_CSP="default-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'"
SECURITY_HSTS_ENABLED=true
SECURITY_HSTS_MAX_AGE=31536000
SECURITY_HSTS_INCLUDE_SUBDOMAINS=true
SECURITY_HSTS_PRELOAD=true

# Trusted proxies / hosts (behind ALB/CloudFront). APP_TRUSTED_HOSTS empty = no host restriction.
TRUSTED_PROXIES=*
APP_TRUSTED_HOSTS=

# Sessions / cookies (production: HTTPS => secure cookie true)
SESSION_DRIVER=redis
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
SESSION_HTTP_ONLY=true
SESSION_ENCRYPT=true

# CORS (comma-separated allow-list; never *)
CORS_ALLOWED_ORIGINS=http://localhost:3000
CORS_SUPPORTS_CREDENTIALS=true

# Logging (production: json to stdout)
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Queue / Horizon
QUEUE_CONNECTION=redis
QUEUE_FAILED_DRIVER=database-uuids
# retry_after MUST exceed the longest Horizon supervisor timeout (exports=300s) or a running job is
# processed twice. Keep >= 360. block_for is opt-in blocking-pop (seconds); leave unset to poll.
QUEUE_RETRY_AFTER=360
DB_QUEUE_RETRY_AFTER=360
# REDIS_QUEUE_BLOCK_FOR=5
# Dead-letter (failed_jobs) retention in hours before pruning. Default 720 (30 days).
QUEUE_FAILED_PRUNE_HOURS=720
HORIZON_DEFAULT_MAX_PROCESSES=4
HORIZON_NOTIFICATIONS_MAX_PROCESSES=6
HORIZON_EXPORTS_MAX_PROCESSES=2
# Resilient deploy restarts + periodic worker recycling (memory-leak / stale-connection safety).
HORIZON_FAST_TERMINATION=true
HORIZON_MEMORY_LIMIT=128
HORIZON_DEFAULT_MAX_TIME=3600
HORIZON_DEFAULT_MAX_JOBS=1000
HORIZON_NOTIFICATIONS_MAX_TIME=3600
HORIZON_NOTIFICATIONS_MAX_JOBS=2000
HORIZON_EXPORTS_MAX_TIME=3600
HORIZON_EXPORTS_MAX_JOBS=500

# Require confirmed MFA for /admin access (recommended in production)
ADMIN_REQUIRE_MFA=false
