# HELBARON API — production environment TEMPLATE (placeholders only; contains NO secrets).
# Copy to .env on the production host and replace every <...>. `php artisan config:validate --strict`
# must pass before serving traffic (also enforced at web boot by ProductionConfigValidator).

APP_NAME=<Academy Name>
APP_ENV=production
APP_KEY=            # <generate: php artisan key:generate --show>
APP_DEBUG=false
APP_URL=https://api.<your-domain>
# Optional override for the release string reported by GET /api/v1/version. Normally left blank:
# CI bakes APP_RELEASE and APP_BUILD_SHA into the image at build time, which is the only moment the
# commit is actually known. Before config/app.php existed, NOTHING read this key.
APP_VERSION=

# White-label — this instance belongs to ONE academy.
#
# `php artisan install:academy` writes the academy's name, company, support address, timezone and
# currency into the DATABASE, and the database wins on every surface that renders through
# BrandProfilePort: the site, the admin panel, emails, invoices and certificates. So on an instance
# you are going to install, these keys are PRE-INSTALL DEFAULTS rather than required settings, and
# you can leave most of them as they are.
#
# The exception is APP_NAME. The MFA issuer — the label inside a learner's authenticator app — is
# read from IDENTITY_MFA_ISSUER -> BRAND_NAME_EN -> APP_NAME at config-cache time, because it is
# needed on a path that must not query for a branding row. Set APP_NAME to the academy's name.
# install:academy warns you at the end if the environment still disagrees with what it just wrote.
BRAND_NAME_EN=<Academy Name>
BRAND_NAME_AR=<اسم الأكاديمية>
BRAND_COMPANY_NAME=<Legal Company Name>
BRAND_SUPPORT_EMAIL=support@<your-domain>
BRAND_SUPPORT_PHONE=<+000 000 0000>
BRAND_ADDRESS_EN=<City, Country>
BRAND_ADDRESS_AR=<المدينة، الدولة>
BRAND_TIMEZONE=<e.g. Africa/Cairo>
BRAND_CURRENCY=<e.g. EGP>
BRAND_THEME_PRESET=default
# Printed on every certificate. COMMENT IT OUT (as below) to inherit BRAND_COMPANY_NAME — do not
# leave it as `CERTIFICATION_ISSUER=`. A present-but-empty key is not the same as an absent one:
# env()'s default argument never fires for '', so an empty key yields an empty issuer rather than
# the inherited brand.
#CERTIFICATION_ISSUER=

# Host / proxy allow-lists (required behind a load balancer)
APP_TRUSTED_HOSTS=api.<your-domain>
TRUSTED_PROXIES=<lb-cidr, e.g. 10.0.0.0/8>   # or a comma-separated CIDR list

# Database (PostgreSQL 16, externally managed)
DB_CONNECTION=pgsql
DB_HOST=<db-host>
DB_PORT=5432
DB_DATABASE=<db-name>
DB_USERNAME=<db-user>
DB_PASSWORD=<db-password>

# Redis (cache, queue, session)
REDIS_HOST=<redis-host>
REDIS_PORT=6379
REDIS_PASSWORD=<redis-password>
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
QUEUE_CONNECTION=redis

# Logging (structured, shippable; never debug in prod)
LOG_CHANNEL=stack
LOG_LEVEL=info

# Mail
MAIL_MAILER=smtp
MAIL_HOST=<smtp-host>
MAIL_PORT=587
MAIL_USERNAME=<smtp-user>
MAIL_PASSWORD=<smtp-password>
MAIL_FROM_ADDRESS=no-reply@<your-domain>
MAIL_FROM_NAME=HELBARON

# Media — TWO separate selectors, both required. Setting only ingestion produces an instance that
# accepts uploads and then serves learners signed URLs that stream nothing. Never "fake" in prod.
MEDIA_INGESTION_PROVIDER=<mux|s3>
LEARNING_PLAYBACK_PROVIDER=<mux|s3|cloudfront>
LEARNING_PLAYBACK_ALLOW_FAKE=false
LEARNING_PLAYBACK_TTL=600

# Provider notifications (never fake in prod)
NOTIFICATIONS_MAIL_PROVIDER=<mailgun>
NOTIFICATIONS_SMS_PROVIDER=<twilio>
NOTIFICATIONS_PUSH_PROVIDER=<firebase>
NOTIFICATIONS_ALLOW_FAKE=false

# AI is opt-in. Keep disabled until a real enabled provider and credentials are configured.
AI_ENABLED=false
AI_PROVIDER=openai
AI_FAKE_ENABLED=false
AI_ALLOW_FAKE=false
AI_OPENAI_ENABLED=false
OPENAI_API_KEY=<optional-until-ai-enabled>

# Payments (never "fake" in prod unless COMMERCE_ALLOW_FAKE_GATEWAY=true for a non-payment env)
COMMERCE_PAYMENT_PROVIDER=<stripe|paymob|moyasar|hyperpay|tap|aps>
COMMERCE_WEBHOOK_SECRET=<real-webhook-signing-secret>
COMMERCE_ALLOW_FAKE_GATEWAY=false

# Security headers / HSTS (defaults are safe; override only if needed)
SECURITY_HSTS_ENABLED=true

# Error reporting (optional)
SENTRY_LARAVEL_DSN=<optional-sentry-dsn>

# Payment gateway credentials — set the block for whichever COMMERCE_PAYMENT_PROVIDER you chose.
# `php artisan env:validate --production` checks the selected gateway's keys and names any that are
# missing. It checks only the selected one, so unused blocks can stay empty.
#   stripe    STRIPE_SECRET, STRIPE_WEBHOOK_SECRET
#   paymob    PAYMOB_API_KEY, PAYMOB_INTEGRATION_ID, PAYMOB_IFRAME_ID,
#             and one of PAYMOB_HMAC_SECRET / PAYMOB_WEBHOOK_SECRET
#   moyasar   MOYASAR_SECRET_KEY, MOYASAR_WEBHOOK_SECRET, MOYASAR_CALLBACK_URL
#   hyperpay  HYPERPAY_ACCESS_TOKEN, HYPERPAY_ENTITY_ID, HYPERPAY_WEBHOOK_SECRET, HYPERPAY_HOSTED_URL
#   tap       TAP_SECRET_KEY, TAP_WEBHOOK_SECRET, TAP_REDIRECT_URL
#   aps       APS_ACCESS_CODE, APS_MERCHANT_IDENTIFIER, APS_REQUEST_PHRASE, APS_RESPONSE_PHRASE,
#             APS_RETURN_URL

# Backups (compose db-backup service).
# BACKUP_TARGET is a NAMED DOCKER VOLUME by default, deliberately: the previous target was ./backups
# inside the deployment checkout, which the platform replaces on every deploy. Set it to an absolute
# host path to write onto storage you copy off-box.
BACKUP_TARGET=helbaron-dbbackups
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=14
# Dumps smaller than this are treated as failures rather than kept (a pipeline can exit 0 having
# written a truncated file).
BACKUP_MIN_BYTES=512
